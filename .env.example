APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Zivo app: full-screen permission gate until location + notifications granted. Default true if unset.
BLOCKING_PERMISSIONS=true

# Zivo app: show campaigns discovery (megaphone + GET /discover/campaigns). Exposed via GET /platform-info. Default true if unset.
SHOW_CAMPAIGNS_LIST=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Prefix for S3 paths when APP_ENV is local or testing (e.g. "local" -> local/zivo_media/...)
AWS_PATH_PREFIX=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# Platform about videos: use full URLs (recommended) or storage path/disk below
# When set, these override path/disk. Use same URLs as zivo_app for consistency.
# PLATFORM_ABOUT_VIDEO_URL=https://your-cdn-or-storage.com/about-video.mp4
# PLATFORM_ABOUT_CREATOR_VIDEO_URL=https://your-cdn-or-storage.com/about-creator-video.mp4

# Or use storage: path relative to disk (e.g. S3 or public)
# PLATFORM_ABOUT_VIDEO_PATH=platform/about-video.mp4
# PLATFORM_ABOUT_VIDEO_DISK=s3
PLATFORM_ABOUT_CREATOR_VIDEO_PATH=platform/about-creator-video.mp4
PLATFORM_ABOUT_CREATOR_VIDEO_DISK=s3
PLATFORM_ABOUT_CREATOR_DESCRIPTION="Your custom creator description here"

COMPANIES_HOUSE_API_KEY="841d23a6-e7be-4f0f-8c94-b1cd95dc5fdb"

# Contact email shown on login and registration (exposed via /platform-info as support_email)
# CONTACT_EMAIL=support@zivo.app

# Global in-app banner messages shown at top of all app screens (comma-separated).
# Example: BANNER_MESSAGE="Media assignments will begin on the 1st of June 2025,Another notice"
# BANNER_MESSAGE=

# Optional: set a creator as admin (for impersonation). Run: php artisan db:seed --class=AdminCreatorSeeder
# ADMIN_CREATOR_EMAIL=admin@example.com

# API auth: Sanctum access token lifetime in minutes (null/unset = no expiry by time). Mobile app uses refresh tokens to renew.
# Example: 10080 = 7 days per access token before refresh is required.
# SANCTUM_ACCESS_TOKEN_EXPIRATION=10080

# Hashed refresh tokens in user_refresh_tokens; plain token returned to app on login/register/refresh only.
# REFRESH_TOKEN_EXPIRATION_DAYS=90

# Google OAuth
# Web Client ID — must match app EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (used to verify ID tokens)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/callback"
# GOOGLE_FRONTEND_REDIRECT_URI=zivo-app://auth/callback

# Apple Sign In — iOS bundle ID used as JWT audience (must match com.adegiwa.zivo.app)
# APPLE_CLIENT_ID=com.adegiwa.zivo.app